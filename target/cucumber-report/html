 wrong format\n    Given User is on the login page\n    When User entered email \"<email123>\"\n    Then User should not be redirected to the homepage\n    And Error message should be displayed on Email field in a Tool tip\n","mediaType":"text\/x.cucumber.gherkin+plain"}},{"gherkinDocument":{"uri":"file:\/\/\/C:\/Users\/asife\/eclipse-workspace\/TestIngExcerciseAutomation\/src\/test\/java\/features\/2.UserLogin.feature","feature":{"location":{"line":19,"column":1},"tags":[],"language":"en","keyword":"Feature","name":"User Login","description":"","children":[{"background":{"location":{"line":21,"column":3},"keyword":"Background","name":"User clicks sign up & login","description":"","steps":[{"location":{"line":22,"column":5},"keyword":"Given ","keywordType":"Context","text":"User is on the homepage","id":"27b22ac5-adb1-4c3d-95c2-9e5416c28508"},{"location":{"line":23,"column":5},"keyword":"When ","keywordType":"Action","text":"User click on Sign Up & Login from header","id":"a9f7acc5-1329-4a6e-aaaa-961af4204faa"}],"id":"68563027-dafd-4eae-bffc-8757f6bb6d02"}},{"scenario":{"location":{"line":26,"column":3},"tags":[{"location":{"line":25,"column":3},"name":"@Positive","id":"3bf52541-37fb-4450-879d-999a5810c926"}],"keyword":"Scenario","name":"Successful login with valid credentials","description":"","steps":[{"location":{"line":27,"column":5},"keyword":"Given ","keywordType":"Context","text":"User is on the login page","id":"1296d79d-610c-468d-95e1-29219ed1a125"},{"location":{"line":28,"column":5},"keyword":"When ","keywordType":"Action","text":"User enters valid credentials email","id":"8903cb71-e72c-4e38-8736-68af91154575"},{"location":{"line":29,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"User enters valid credentials password <\"Test@123\">","id":"6d9b17c8-1ef8-4365-9cfd-f168dd56d42c"},{"location":{"line":30,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"User clicks on Login button","id":"b199afde-62d9-4689-8872-843a24b13719"},{